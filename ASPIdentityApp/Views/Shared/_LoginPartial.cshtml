@page
@model ASPIdentityApp.Views.Shared.LoginPartialModel
@using ASPIdentityApp.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ASPIdentityApp.Data.ApplicationUser> SignInManager
@inject UserManager<ASPIdentityApp.Data.ApplicationUser> UserManager

<ul class="navbar-nav ms-auto">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        Hello @UserManager.GetUserName(User)!
    </li>
    <li class="nav-item">
        <form asp-action="Logout" asp-controller="Home">
            <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
        </form>
    </li>
}
else
{
<h6> <a asp-area="Identity" asp asp-page="/Account/Register">Register</a> | <a asp-area="Identity" asp asp-page="/Account/Login">Login</a> </h6>


    
}
</ul>
